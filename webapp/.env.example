# Copy to .env.local (never commit it, never keep real keys in the shared project folder).
# Without a key the puzzle runner uses a simulated model (approximate scores).
ANTHROPIC_API_KEY=

# Where lessons/, fundamentals/ and puzzles/ live. Default: the parent folder of this app.
# CONTENT_DIR=/path/to/future-proofing-course

# Models (defaults shown). The runner plays the learner's prompt; the judge grades fuzzy checks.
# PUZZLE_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5

# Abuse limits for the free public tier. Each run makes several model calls, so calls are capped too.
# RATE_LIMIT_PER_HOUR=30         # puzzle runs per client per hour
# RATE_LIMIT_CALLS_PER_HOUR=150  # model calls per client per hour
# DAILY_RUN_CAP=2000             # puzzle runs per day across all learners
# DAILY_CALL_CAP=10000           # model calls per day across all learners

# Who is "the client"? Forwarded-for headers are forgeable, so they are ignored unless you say which to trust.
# Behind a platform that sets and overwrites one header:   TRUST_IP_HEADER=x-real-ip
# Behind N proxies you run (reads Nth entry from the right of X-Forwarded-For):   TRUSTED_PROXY_HOPS=1
# With neither set, all callers share one bucket: safe, but strict.
