# Copy to .env.local (never commit it, never keep real keys in the shared project folder).
# Without a key the puzzle runner uses a simulated model (approximate scores).
ANTHROPIC_API_KEY=

# Where lessons/, fundamentals/ and puzzles/ live. Default: the parent folder of this app.
# CONTENT_DIR=/path/to/future-proofing-course

# Models (defaults shown). The runner plays the learner's prompt; the judge grades fuzzy checks.
# PUZZLE_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5

# Abuse limits for the free public tier.
# RATE_LIMIT_PER_HOUR=30     # puzzle runs per IP per hour
# DAILY_RUN_CAP=2000         # puzzle runs per day across all learners
